{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/al-iniciar.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git fetch:*)",
      "Bash(git pull --rebase --autostash origin dev)",
      "Bash(ls contexto/bitacora:*)",
      "Bash(TZ=America/Santiago date:*)",
      "Bash(curl -s http://localhost:5173/api/inventario:*)",
      "Bash(curl -s http://localhost:5173/api/historial:*)"
    ],
    "deny": [
      "Bash(git push origin main:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force:*)",
      "Read(./web/.env)",
      "Read(./web/.env.local)"
    ]
  }
}
