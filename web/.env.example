# Copia este archivo a web/.env y llénalo. web/.env no se sube al repo.
# Sin DATABASE_URL, `npm run dev` le pasa /api a la API publicada (bicho-dev.vercel.app).

# Neon, proyecto "crbrc-platanus", base "inventario" (pídela al equipo)
DATABASE_URL=""
# Clave del equipo para editar el inventario y preguntarle a Claude
INVENTARIO_TOKEN=""
# Para el botón "Preguntar" (console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=""
